<Window x:Class="NoteDesk.ajustes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NoteDesk"
        mc:Ignorable="d"
       Title="Ajustes - NoteDesk" Height="650" Width="450"
        Background="#EBE2CD"
        WindowStartupLocation="CenterScreen">

    <!-- ScrollViewer por si la pantalla es pequeña -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="25">

        <StackPanel>

            <!-- Título de la Sección -->
            <TextBlock Text="Ajustes"
                       FontSize="30"
                       FontWeight="Bold"
                       FontFamily="Segoe Script, Brush Script MT, Cursive"
                       Foreground="#1A1A1A"/>

            <TextBlock Text="Personaliza tu espacio de trabajo ♡"
                       FontSize="13"
                       FontFamily="Segoe Print, Comic Sans MS"
                       Foreground="#333333"
                       Margin="0,2,0,20"/>

            <!-- SECCIÓN 1: APARIENCIA -->
            <TextBlock Text="Apariencia" FontSize="14" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,8"/>
            <Border Background="#F4EEE0" CornerRadius="12" Padding="15" Margin="0,0,0,15" BorderBrush="#DCD3C1" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Modo Oscuro / Pastel Suave" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBlock Text="Ajusta el ambiente visual de la aplicación" FontSize="11" Foreground="#777777"/>
                    </StackPanel>

                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- SECCIÓN 2: NOTIFICACIONES -->
            <TextBlock Text="Notificaciones" FontSize="14" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,8"/>
            <Border Background="#F4EEE0" CornerRadius="12" Padding="15" Margin="0,0,0,15" BorderBrush="#DCD3C1" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Recordatorios de tareas" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                            <TextBlock Text="Recibe avisos cuando se acerque la hora límite" FontSize="11" Foreground="#777777"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center" Cursor="Hand" IsChecked="True"/>
                    </Grid>

                    <Separator Background="#DCD3C1" Height="1" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sonidos suaves" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                            <TextBlock Text="Reproducir un tono al completar tareas" FontSize="11" Foreground="#777777"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECCIÓN 3: DATOS Y RESPALDO -->
            <TextBlock Text="Datos" FontSize="14" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,8"/>
            <Border Background="#F4EEE0" CornerRadius="12" Padding="15" Margin="0,0,0,15" BorderBrush="#DCD3C1" BorderThickness="1">
                <StackPanel>
                    <Button Content="📥 Exportar respaldo de tareas" 
                            Background="Transparent" 
                            BorderBrush="Transparent" 
                            Foreground="#333333" 
                            HorizontalAlignment="Left" 
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Margin="0,0,0,10"/>

                    <Button Content="🗑️ Borrar todas las tareas completadas" 
                            Background="Transparent" 
                            BorderBrush="Transparent" 
                            Foreground="#D9534F" 
                            HorizontalAlignment="Left" 
                            Cursor="Hand"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- SECCIÓN 4: ACERCA DE -->
            <TextBlock Text="Acerca de" FontSize="14" FontWeight="SemiBold" Foreground="#444444" Margin="0,0,0,8"/>
            <Border Background="#F4EEE0" CornerRadius="12" Padding="15" Margin="0,0,0,10" BorderBrush="#DCD3C1" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="NoteDesk - Versión 1.0.0" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                    <TextBlock Text="Hecho con mucho amor y pequeños pasos ♡" FontSize="11" Foreground="#777777" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>

    </ScrollViewer>
</Window>
