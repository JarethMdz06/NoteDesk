<Window x:Class="NoteDesk.ajustes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes - NoteDesk"
        Height="780"
        Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EBE2CD">

    <Window.Resources>

        <!-- ================= SOMBRA ================= -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12"
                          ShadowDepth="3"
                          Opacity="0.16"/>


        <!-- ================= CHECKBOX PERSONALIZADO ================= -->

        <Style x:Key="CheckNoteDesk"
               TargetType="CheckBox">

            <Setter Property="Width"
                    Value="22"/>

            <Setter Property="Height"
                    Value="22"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="CheckBox">

                        <Grid>

                            <Border x:Name="Caja"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="3"
                                    Background="#FFFDF7"
                                    BorderBrush="#888888"
                                    BorderThickness="1.5"/>

                            <TextBlock x:Name="Palomita"
                                       Text="✓"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Caja"
                                        Property="Background"
                                        Value="#48B989"/>

                                <Setter TargetName="Caja"
                                        Property="BorderBrush"
                                        Value="#48B989"/>

                                <Setter TargetName="Palomita"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ====================================================== -->
    <!-- FONDO PRINCIPAL -->
    <!-- ====================================================== -->

    <Border Margin="12"
            Background="#ECE3D0"
            CornerRadius="20"
            Effect="{StaticResource CardShadow}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="24">


                <!-- ====================================================== -->
                <!-- ENCABEZADO -->
                <!-- ====================================================== -->

                <Grid Margin="0,0,0,26">

                    <Border Background="#EBB83A"
                            CornerRadius="14"
                            Padding="22,18"
                            Effect="{StaticResource CardShadow}">

                        <StackPanel>

                            <TextBlock Text="Ajustes"
                                       FontFamily="Segoe Script"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="#111111"/>

                            <TextBlock Text="Personaliza tu espacio de trabajo ♡"
                                       FontFamily="Segoe Print"
                                       FontSize="12"
                                       Foreground="#333333"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- Clip decorativo -->

                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-13,18,0"
                            Width="22"
                            Height="58"
                            CornerRadius="9"
                            BorderBrush="#A3485E"
                            BorderThickness="4"
                            Background="Transparent"/>

                </Grid>



                <!-- ====================================================== -->
                <!-- APARIENCIA -->
                <!-- ====================================================== -->

                <TextBlock Text="Apariencia"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#222222"/>

                <TextBlock Text="Ajusta el ambiente visual de la aplicación"
                           FontSize="12"
                           Foreground="#777777"
                           Margin="0,3,0,10"/>


                <Border Background="#F8F4EA"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,0,0,24"
                        Effect="{StaticResource CardShadow}">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Modo Oscuro / Pastel Suave"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#222222"/>

                            <TextBlock Text="Ajusta el ambiente visual de la aplicación"
                                       FontSize="11"
                                       Foreground="#777777"
                                       Margin="0,3,0,0"/>

                        </StackPanel>


                        <CheckBox x:Name="ChkModoOscuro"
                                  Grid.Column="1"
                                  Style="{StaticResource CheckNoteDesk}"
                                  VerticalAlignment="Center"
                                  Margin="15,0,0,0"/>

                    </Grid>

                </Border>



                <!-- ====================================================== -->
                <!-- NOTIFICACIONES -->
                <!-- ====================================================== -->

                <TextBlock Text="Notificaciones"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#222222"/>

                <TextBlock Text="Configura cómo y cuándo recibir avisos"
                           FontSize="12"
                           Foreground="#777777"
                           Margin="0,3,0,10"/>


                <Border Background="#F8F4EA"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,0,0,24"
                        Effect="{StaticResource CardShadow}">

                    <StackPanel>


                        <!-- ================= RECORDATORIOS ================= -->

                        <Grid Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock Text="Recordatorios de tareas"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#222222"/>

                                <TextBlock Text="Recibe avisos cuando se acerque la hora límite"
                                           FontSize="11"
                                           Foreground="#777777"
                                           Margin="0,3,0,0"/>

                            </StackPanel>


                            <CheckBox x:Name="ChkRecordatorios"
                                      Grid.Column="1"
                                      Style="{StaticResource CheckNoteDesk}"
                                      VerticalAlignment="Center"
                                      Margin="15,0,0,0"
                                      IsChecked="True"/>

                        </Grid>


                        <!-- Línea divisora -->

                        <Border Height="1"
                                Background="#DED4BD"
                                Margin="0,0,0,14"/>


                        <!-- ================= ACTIVAR SONIDO ================= -->

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock Text="Activar Sonido"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#222222"/>

                                <TextBlock Text="Reproducir un tono al completar tareas"
                                           FontSize="11"
                                           Foreground="#777777"
                                           Margin="0,3,0,0"/>

                            </StackPanel>


                            <CheckBox x:Name="ChkSonido"
                                      Grid.Column="1"
                                      Style="{StaticResource CheckNoteDesk}"
                                      VerticalAlignment="Center"
                                      Margin="15,0,0,0"/>

                        </Grid>

                    </StackPanel>

                </Border>



                <!-- ====================================================== -->
                <!-- ACERCA DE -->
                <!-- ====================================================== -->

                <TextBlock Text="Acerca de"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#222222"/>

                <TextBlock Text="Información sobre la aplicación"
                           FontSize="12"
                           Foreground="#777777"
                           Margin="0,3,0,10"/>


                <Border Background="#F8F4EA"
                        CornerRadius="14"
                        Padding="16"
                        Margin="0,0,0,15"
                        Effect="{StaticResource CardShadow}">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock Text="NoteDesk - Versión 1.0.0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#222222"/>

                            <TextBlock Text="Hecho con mucho amor y pequeños pasos ♡"
                                       FontSize="11"
                                       Foreground="#777777"
                                       Margin="0,4,0,0"/>

                        </StackPanel>


                        <TextBlock Grid.Column="1"
                                   Text="›"
                                   FontSize="27"
                                   Foreground="#333333"
                                   VerticalAlignment="Center"
                                   Margin="15,0,2,0"/>

                    </Grid>

                </Border>


            </StackPanel>

        </ScrollViewer>

    </Border>

</Window>