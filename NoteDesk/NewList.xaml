<Window x:Class="NoteDesk.NewList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NoteDesk"
        mc:Ignorable="d"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="Crear Nueva Tarea" Height="700" Width="480"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <!-- Este Border es el que le da la forma curva a toda la ventana -->
    <Border Background="#EBE2CD" CornerRadius="22" Padding="20">

        <!-- Un StackPanel principal para ordenar todo verticalmente en orden -->
        <StackPanel VerticalAlignment="Top">

            <!-- Título principal -->
            <TextBlock Text="Crear Nueva Tarea"
                       FontSize="32"
                       FontWeight="Bold"
                       FontFamily="Segoe Script, Brush Script MT, Cursive"
                       Foreground="#1A1A1A"/>

            <!-- Subtítulo -->
            <TextBlock Text="Pequeños pasos, grandes logros ♡"
                       FontSize="14"
                       FontFamily="Segoe Print, Comic Sans MS"
                       Foreground="#333333"
                       Margin="0,2,0,20"/>

            <!-- Contenedor con bordes redondeados para el campo de texto -->
            <Border Background="#F4EEE0" CornerRadius="8" BorderBrush="#DCD3C1" BorderThickness="1" Padding="4">
                <TextBox x:Name="TxtTituloTarea"
                         Text="Ej. Preparar presentación, Comprar pan..."
                         Foreground="#555555"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="14"
                         Padding="8,6"
                         VerticalContentAlignment="Center"/>
            </Border>

            <!-- Etiqueta para indicar qué campo es -->
            <TextBlock Text="Descripción"
           FontSize="14"
           FontWeight="SemiBold"
           Foreground="#333333"
           Margin="0,15,0,6"/>

            <!-- Contenedor con bordes redondeados para la Descripción -->
            <Border Background="#F4EEE0" CornerRadius="8" BorderBrush="#DCD3C1" BorderThickness="1" Padding="6">
                <TextBox x:Name="TxtDescripcion"
                         Text="Agrega detalles o notas adicionales..."
                         Foreground="#555555"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="14"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="80"
                         VerticalContentAlignment="Top"/>
            </Border>

        </StackPanel>

    </Border>

</Window>
