<Window x:Class="NoteDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="NoteDesk - Mis Tareas"
        Height="780"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#EBE2CD">

    <!-- Fondo de Pantalla Principal / Ventana Flotante -->
    <Border Margin="15"
            CornerRadius="20"
            Background="#ECE3D0"
            Effect="{StaticResource StickyShadow}">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= HEADER / BARRA SUPERIOR ================= -->

            <Grid Grid.Row="0"
                  Margin="773,15,20,5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

            </Grid>

            <!-- ================= CONTENIDO PRINCIPAL ================= -->

            <Grid Grid.Row="1"
                  Margin="20,10,20,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= COLUMNA IZQUIERDA ================= -->

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Top">

                    <!-- NOTA ADHESIVA AMARILLA -->

                    <Grid Margin="0,0,0,20">

                        <Border Background="#EBB83A"
                                CornerRadius="12"
                                Padding="25,20"
                                Effect="{StaticResource StickyShadow}"
                                Margin="0,0,0,0">

                            <StackPanel>

                                <TextBlock Text="Mis Tareas"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           FontFamily="Segoe Script, Brush Script MT, Cursive"
                                           Foreground="#1A1A1A"/>

                                <TextBlock Text="Pequeños pasos, grandes logros ♡"
                                           FontSize="15"
                                           FontFamily="Segoe Print, Comic Sans MS"
                                           Foreground="#333333"
                                           Margin="0,5,0,0"/>

                            </StackPanel>

                        </Border>

                        <!-- Clip decorativo -->

                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-16,9,0"
                                Width="28"
                                Height="76"
                                CornerRadius="10"
                                BorderBrush="#A3485E"
                                BorderThickness="5"
                                Background="Transparent"/>
                        <Button
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,32,12"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">

                                    <Grid Width="50"
                                          Height="50">

                                        <!-- Círculo rojo -->
                                        <Ellipse Width="50"
                                                 Height="50"
                                                 Fill="#E74C4C"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">

                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="10"
                                                                  ShadowDepth="3"
                                                                  Opacity="0.30"/>
                                            </Ellipse.Effect>

                                        </Ellipse>

                                        <!-- Signo + centrado -->
                                        <Grid Width="20"
                                              Height="20"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">

                                            <Border Width="2"
                                                    Height="20"
                                                    Background="White"
                                                    CornerRadius="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>

                                            <Border Width="20"
                                                    Height="2"
                                                    Background="White"
                                                    CornerRadius="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>

                                        </Grid>

                                    </Grid>

                                </ControlTemplate>
                            </Button.Template>

                        </Button>

                    </Grid>

                    <!-- ================= FILTRO ================= -->

                    <Grid Margin="0,0,0,12">

                        <TextBlock Text="Todas las tareas"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#222222"
                                   VerticalAlignment="Center"/>

                        <Border HorizontalAlignment="Right"
                                Background="#E8DEC9"
                                CornerRadius="12"
                                Padding="14,4">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="Todas"
                                           FontSize="13"
                                           Foreground="#444444"
                                           Margin="0,0,5,0"/>

                                <TextBlock Text="˅"
                                           FontSize="11"
                                           Foreground="#444444"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- ================= LISTA DE TAREAS ================= -->

                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  Height="360"
                                  Background="#EBE2CD">

                        <StackPanel>

                            <!-- TAREA 1 -->

                            <Border Style="{StaticResource TaskCardStyle}" Visibility="Collapsed">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="26"
                                            Height="26"
                                            CornerRadius="6"
                                            Background="#3FA772"
                                            Margin="0,0,12,0">

                                        <TextBlock Text="✓"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="Desayunar"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"/>



                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="⋮"
                                               FontSize="18"
                                               Foreground="#777777"
                                               VerticalAlignment="Center"
                                               Margin="5,0"/>

                                </Grid>

                            </Border>

                            <!-- TAREA 2 -->

                            <Border Style="{StaticResource TaskCardStyle}" Visibility="Collapsed">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="26"
                                            Height="26"
                                            CornerRadius="6"
                                            BorderBrush="#888888"
                                            BorderThickness="2"
                                            Margin="0,0,12,0">

                                        <TextBlock Text=""
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="Revisar-correos"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"/>


                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="⋮"
                                               FontSize="18"
                                               Foreground="#777777"
                                               VerticalAlignment="Center"
                                               Margin="5,0"/>

                                </Grid>

                            </Border>

                            <!-- TAREA 3 -->

                            <Border Style="{StaticResource TaskCardStyle}" Visibility="Collapsed">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="26"
                                            Height="26"
                                            CornerRadius="6"
                                            BorderBrush="#888888"
                                            BorderThickness="2"
                                            Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="Trabajar en el proyecto"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#111111"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,3,0,0">


                                            <Border Background="#F1B1B1"
                                                    CornerRadius="8"
                                                    Padding="6,1"
                                                    Margin="0,2,0,0">

                                                <TextBlock Text="Entrega: mañana"
                                                           FontSize="11"
                                                           Foreground="#882222"
                                                           FontWeight="SemiBold"/>

                                            </Border>

                                        </StackPanel>

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="⋮"
                                               FontSize="18"
                                               Foreground="#777777"
                                               VerticalAlignment="Center"
                                               Margin="5,0"/>

                                </Grid>

                            </Border>

                            <!-- TAREA 4 -->

                            <Border Style="{StaticResource TaskCardStyle}" Visibility="Collapsed">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="26"
                                            Height="26"
                                            CornerRadius="6"
                                            BorderBrush="#888888"
                                            BorderThickness="2"
                                            Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="Hacer ejercicio"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"/>



                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="⋮"
                                               FontSize="18"
                                               Foreground="#777777"
                                               VerticalAlignment="Center"
                                               Margin="5,0"/>

                                </Grid>

                            </Border>

                            <!-- TAREA 5 -->

                            <Border Style="{StaticResource TaskCardStyle}" Visibility="Collapsed">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="26"
                                            Height="26"
                                            CornerRadius="6"
                                            BorderBrush="#888888"
                                            BorderThickness="2"
                                            Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="Leer un libro"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"/>


                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="⋮"
                                               FontSize="18"
                                               Foreground="#777777"
                                               VerticalAlignment="Center"
                                               Margin="5,0"/>

                                </Grid>

                            </Border>

                            <!-- TAREA 6 -->

                            <Border Style="{StaticResource TaskCardStyle}" Visibility="Collapsed">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="26"
                                            Height="26"
                                            CornerRadius="6"
                                            BorderBrush="#888888"
                                            BorderThickness="2"
                                            Margin="0,2,12,0"/>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="Preparar la cena"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"/>



                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="⋮"
                                               FontSize="18"
                                               Foreground="#777777"
                                               VerticalAlignment="Center"
                                               Margin="5,0"/>

                                </Grid>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </StackPanel>

                <!-- ================= COLUMNA DERECHA ================= -->

                <StackPanel Grid.Column="2">

                    <!-- ================= CALENDARIO ================= -->

                    <Border Background="#F8F4EA"
                            CornerRadius="16"
                            Padding="16"
                            Margin="0,0,0,15"
                            Effect="{StaticResource CardShadow}">

                        <StackPanel>

                            <Grid Margin="0,0,0,10">

                                <TextBlock Text="Calendario"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#222222"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">

                                    <TextBlock Text="‹"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#666666"
                                               Margin="0,0,10,0"/>

                                    <TextBlock Text="Abril 2025"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#333333"/>

                                    <TextBlock Text="›"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#666666"
                                               Margin="10,0,0,0"/>

                                </StackPanel>

                            </Grid>

                            <!-- DÍAS -->

                            <UniformGrid Columns="7"
                                         Margin="0,0,0,8">

                                <TextBlock Text="Dom"
                                           FontSize="11"
                                           Foreground="#777777"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Lun"
                                           FontSize="11"
                                           Foreground="#777777"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Mar"
                                           FontSize="11"
                                           Foreground="#777777"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Mié"
                                           FontSize="11"
                                           Foreground="#777777"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Jue"
                                           FontSize="11"
                                           Foreground="#777777"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Vie"
                                           FontSize="11"
                                           Foreground="#777777"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Sáb"
                                           FontSize="11"
                                           Foreground="#777777"
                                           HorizontalAlignment="Center"/>

                            </UniformGrid>

                            <!-- NÚMEROS DEL CALENDARIO -->

                            <UniformGrid Columns="7">

                                <TextBlock Text="30"
                                           Foreground="#BBBBBB"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="31"
                                           Foreground="#BBBBBB"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="1"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="2"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="3"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="4"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="5"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="6"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="7"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="8"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="9"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="10"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="11"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="12"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="13"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="14"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="15"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="16"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="17"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="18"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="19"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="20"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <Border Background="#2B53B4"
                                        CornerRadius="12"
                                        Width="24"
                                        Height="24">

                                    <TextBlock Text="21"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock Text="22"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="23"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="24"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="25"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                                <TextBlock Text="26"
                                           Foreground="#333333"
                                           HorizontalAlignment="Center"
                                           Margin="0,4"/>

                            </UniformGrid>

                        </StackPanel>

                    </Border>

                    <!-- ================= ENFOQUE Y PROGRESO ================= -->

                    <Border Background="#F8F4EA"
                            CornerRadius="16"
                            Padding="26"
                            Effect="{StaticResource CardShadow}" Height="246">

                        <StackPanel>

                            <TextBlock Text="Enfoque y Progreso"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#222222"
                                       Margin="0,0,0,12"/>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                </Grid.ColumnDefinitions>

                                <!-- PRIORIDADES -->

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,10,0">

                                    <TextBlock Text="Tareas Prioritarias"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#444444"
                                               Margin="0,0,0,8"/>

                                    <Border Style="{StaticResource SubCardStyle}">

                                        <StackPanel>

                                            <Grid>

                                                <TextBlock Text="Trabajar en el proyecto"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="."
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"/>

                                            </Grid>

                                            <Border Background="#F1B1B1"
                                                    CornerRadius="6"
                                                    Padding="4,1"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,4">

                                                <TextBlock Text="Prioridad Alta"
                                                           FontSize="9"
                                                           Foreground="#882222"
                                                           FontWeight="Bold"/>

                                            </Border>



                                        </StackPanel>

                                    </Border>

                                    <Border Style="{StaticResource SubCardStyle}">

                                        <StackPanel>

                                            <Grid>

                                                <TextBlock Text="Hacer ejercicio"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>

                                                <TextBlock Text="."
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"/>

                                            </Grid>

                                            <Border Background="#F7D89C"
                                                    CornerRadius="6"
                                                    Padding="4,1"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,4">

                                                <TextBlock Text="Prioridad Media"
                                                           FontSize="9"
                                                           Foreground="#774400"
                                                           FontWeight="Bold"/>

                                            </Border>



                                        </StackPanel>

                                    </Border>

                                </StackPanel>

                                <!-- PROGRESO -->

                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Center">

                                    <TextBlock Text="Progreso Diario"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#444444"
                                               Margin="0,0,0,8"/>

                                    <Grid Width="100"
                                          Height="100"
                                          Margin="0,5">

                                        <Ellipse Stroke="#D0EBE8"
                                                 StrokeThickness="10"/>

                                        <Ellipse Stroke="#FF0C8078"
                                                 StrokeThickness="10"
                                                 StrokeDashArray="3,1"
                                                 StrokeDashOffset="1"/>

                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">

                                            <TextBlock Text="0%"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#111111"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock Text="Completado"
                                                       FontSize="9"
                                                       Foreground="#666666"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock Text="2 de 6 tareas"
                                                       FontSize="8"
                                                       Foreground="#888888"
                                                       HorizontalAlignment="Center"/>

                                        </StackPanel>

                                    </Grid>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,8,0,0">

                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="#E58383"
                                                 Margin="0,0,4,0"/>

                                        <TextBlock Text="Progreso Total del Día"
                                                   FontSize="9"
                                                   Foreground="#666666"/>

                                    </StackPanel>

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>

            <!-- ================= BARRA DE NAVEGACIÓN INFERIOR ================= -->

            <Border Grid.Row="2"
                    Background="#E7CD63"
                    CornerRadius="0,0,20,20"
                    Padding="15,10">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <UniformGrid Grid.Column="0"
                                 Rows="1"
                                 Columns="4"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center">

                        <!-- Inicio -->

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="🏠"
                                       FontSize="14"
                                       Margin="0,0,5,0"/>

                            <TextBlock Text="Inicio"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#444444"/>

                        </StackPanel>

                        <!-- Tareas -->

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="☑"
                                       FontSize="14"
                                       Margin="0,0,5,0"
                                       Foreground="#222222"/>

                            <TextBlock Text="Tareas"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#222222"/>

                        </StackPanel>

                        <!-- Calendario -->

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="📅"
                                       FontSize="14"
                                       Margin="0,0,5,0"/>

                            <TextBlock Text="Calendario"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#444444"/>

                        </StackPanel>

                        <!-- Ajustes -->

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <TextBlock Text="⚙"
                                       FontSize="14"
                                       Margin="0,0,5,0"/>

                            <TextBlock Text="Ajustes"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#444444"/>

                        </StackPanel>

                    </UniformGrid>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>