<Window x:Class="NoteDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoteDesk - Mis Tareas"
        Height="820"
        Width="1210"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ColorVentana}">

    <Window.Resources>
        <ImageBrush x:Key="MainWindowBackground"
                    ImageSource="/NoteDesk;component/Assets/Img/fondo.jpg"
                    Stretch="UniformToFill"/>

        <Style x:Key="MainCalendarNavigationButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource ColorSuperficie}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorde}"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ColorMesSeleccionado}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ColorBordeMesSeleccionado}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ColorHeader}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtareaCheckBox" TargetType="CheckBox">
            <Setter Property="Width" Value="23"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckBorder"
                                Background="{DynamicResource ColorTarjetaInterna}"
                                BorderBrush="{DynamicResource ColorBorde}"
                                BorderThickness="2"
                                CornerRadius="6">
                            <TextBlock x:Name="CheckMark"
                                       Text="✓"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#3FA772"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#3FA772"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fondo de Pantalla Principal / Ventana Flotante -->
    <Border Margin="15"
            CornerRadius="20"
            Background="{StaticResource MainWindowBackground}"
            Effect="{StaticResource StickyShadow}">

        <Grid>
            <Border Background="{DynamicResource MainWindowBackgroundOverlay}"
                    CornerRadius="20"
                    IsHitTestVisible="False"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- ================================================== -->
                <!-- HEADER / BARRA SUPERIOR -->
                <!-- ================================================== -->

                <Grid Grid.Row="0"
                  Margin="773,15,20,5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                </Grid>


                <!-- ================================================== -->
                <!-- CONTENIDO PRINCIPAL -->
                <!-- ================================================== -->

                <Grid x:Name="VistaInicio"
                  Grid.Row="1"
                  Margin="20,10,20,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>


                    <!-- ================================================== -->
                    <!-- COLUMNA IZQUIERDA -->
                    <!-- ================================================== -->

                    <StackPanel Grid.Column="0"
                            VerticalAlignment="Top">


                        <!-- NOTA ADHESIVA AMARILLA -->

                        <Grid Margin="0,0,0,20">

                            <Border Background="{DynamicResource ColorHeader}"
                                CornerRadius="12"
                                Padding="25,20"
                                Effect="{StaticResource StickyShadow}"
                                Margin="0">

                                <StackPanel>

                                    <TextBlock Text="Mis Tareas"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           FontFamily="Segoe Script, Brush Script MT, Cursive"
                                           Foreground="{DynamicResource ColorTextoHeader}"/>

                                    <TextBlock Text="Pequeños pasos, grandes logros ♡"
                                           FontSize="15"
                                           FontFamily="Segoe Print, Comic Sans MS"
                                           Foreground="{DynamicResource ColorTextoHeader}"
                                           Opacity="0.85"
                                           Margin="0,5,0,0"/>

                                </StackPanel>

                            </Border>





                            <!-- BOTÓN + -->

                            <Button x:Name="BtnAddTask"
                                Width="50"
                                Height="50"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,32,12"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0"
                                Click="BtnAddTask_Click">

                                <Button.Template>

                                    <ControlTemplate TargetType="Button">

                                        <Grid Width="50"
                                          Height="50">

                                            <Ellipse Width="50"
                                                 Height="50"
                                                 Fill="#c32818"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">

                                                <Ellipse.Effect>

                                                    <DropShadowEffect BlurRadius="10"
                                                                  ShadowDepth="3"
                                                                  Opacity="0.30"/>

                                                </Ellipse.Effect>

                                            </Ellipse>


                                            <!-- SIGNO + -->

                                            <Grid Width="20"
                                              Height="20"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">

                                                <Border Width="2"
                                                    Height="20"
                                                    Background="{DynamicResource ColorTextoHeader}"
                                                    CornerRadius="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>

                                                <Border Width="20"
                                                    Height="2"
                                                    Background="{DynamicResource ColorTextoHeader}"
                                                    CornerRadius="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>

                                            </Grid>

                                        </Grid>

                                    </ControlTemplate>

                                </Button.Template>

                            </Button>

                        </Grid>


                        <!-- ================================================== -->
                        <!-- FILTRO -->
                        <!-- ================================================== -->

                        <Grid Margin="0,0,0,12">

                            <TextBlock Text="Tareas"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ColorTexto}"
                                   VerticalAlignment="Center"/>

                            <ComboBox x:Name="CmbFiltroCategoria"
                                  Width="150"
                                  Height="36"
                                  HorizontalAlignment="Right"
                                  Style="{StaticResource NoteDeskComboBox}"
                                  SelectedValuePath="Tag">
                                <ComboBoxItem Content="Todas" Tag="*" IsSelected="True"/>
                                <ComboBoxItem Content="Work" Tag="Work"/>
                                <ComboBoxItem Content="School" Tag="School"/>
                                <ComboBoxItem Content="Home" Tag="Home"/>
                                <ComboBoxItem Content="Shopping" Tag="Shopping"/>
                                <ComboBoxItem Content="Personal" Tag="Personal"/>
                                <ComboBoxItem Content="Hobbies" Tag="Hobbies"/>
                                <ComboBoxItem Content="Health" Tag="Health"/>
                                <ComboBoxItem Content="Other" Tag="Other"/>
                                <ComboBoxItem Content="Sin categoría" Tag=""/>
                            </ComboBox>

                        </Grid>


                        <!-- ================================================== -->
                        <!-- LISTA DE TAREAS -->
                        <!-- ================================================== -->

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Height="360"
                                  Background="Transparent"
                                  BorderThickness="0">

                            <StackPanel x:Name="ListTask"
                                    Background="Transparent">

                            </StackPanel>

                        </ScrollViewer>

                    </StackPanel>


                    <!-- ================================================== -->
                    <!-- COLUMNA DERECHA -->
                    <!-- ================================================== -->

                    <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="5,4,10,8">


                            <!-- ================================================== -->
                            <!-- CALENDARIO DINÁMICO -->
                            <!-- ================================================== -->

                            <Border Background="{DynamicResource ColorTarjetaInterna}"
                            CornerRadius="16"
                            Padding="14,12"
                            Margin="0,0,0,14"
                            Effect="{StaticResource CardShadow}">

                                <StackPanel>


                                    <!-- ========================================== -->
                                    <!-- ENCABEZADO DEL CALENDARIO -->
                                    <!-- ========================================== -->

                                    <Grid Margin="0,0,0,6">

                                        <TextBlock Text="Calendario"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ColorTexto}"/>


                                        <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">


                                            <!-- MES ANTERIOR -->

                                            <Button Content="‹"
                                            Style="{StaticResource MainCalendarNavigationButton}"
                                            Margin="0,0,8,0"
                                            Click="MesAnterior_Click"/>


                                            <!-- MES / AÑO DINÁMICO -->

                                            <TextBlock x:Name="TxtMesCalendario"
                                               Text="Mes Año"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ColorTexto}"
                                               VerticalAlignment="Center"/>


                                            <!-- MES SIGUIENTE -->

                                            <Button Content="›"
                                            Style="{StaticResource MainCalendarNavigationButton}"
                                            Margin="8,0,0,0"
                                            Click="MesSiguiente_Click"/>

                                        </StackPanel>

                                    </Grid>


                                    <!-- ========================================== -->
                                    <!-- DÍAS DE LA SEMANA -->
                                    <!-- ========================================== -->

                                    <UniformGrid Columns="7"
                                         Margin="0,0,0,4">

                                        <TextBlock Text="Dom"
                                           FontSize="11"
                                           Foreground="{DynamicResource ColorTexto}"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"/>

                                        <TextBlock Text="Lun"
                                           FontSize="11"
                                           Foreground="{DynamicResource ColorTexto}"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"/>

                                        <TextBlock Text="Mar"
                                           FontSize="11"
                                           Foreground="{DynamicResource ColorTexto}"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"/>

                                        <TextBlock Text="Mié"
                                           FontSize="11"
                                           Foreground="{DynamicResource ColorTexto}"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"/>

                                        <TextBlock Text="Jue"
                                           FontSize="11"
                                           Foreground="{DynamicResource ColorTexto}"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"/>

                                        <TextBlock Text="Vie"
                                           FontSize="11"
                                           Foreground="{DynamicResource ColorTexto}"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"/>

                                        <TextBlock Text="Sáb"
                                           FontSize="11"
                                           Foreground="{DynamicResource ColorTexto}"
                                           Opacity="0.6"
                                           HorizontalAlignment="Center"/>

                                    </UniformGrid>


                                    <!-- ========================================== -->
                                    <!-- DÍAS GENERADOS DESDE C# -->
                                    <!-- ========================================== -->
                                    <!--
                                Aquí ya NO escribimos manualmente:
                                
                                1
                                2
                                3
                                4...
                                
                                MainWindow.xaml.cs generará los días
                                automáticamente dependiendo del mes.
                            -->

                                    <UniformGrid x:Name="CalendarioDias"
                                         Columns="7"
                                         Rows="6"/>

                                </StackPanel>

                            </Border>


                            <!-- ================================================== -->
                            <!-- PROGRESO DE LA TAREA SELECCIONADA -->
                            <!-- ================================================== -->

                            <Border Background="{DynamicResource ColorTarjetaInterna}"
                            CornerRadius="16"
                            Padding="14,12"
                            Margin="0,0,0,2"
                            Effect="{StaticResource CardShadow}">
                                <StackPanel>

                                    <!-- ENCABEZADO -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Viewbox Width="22" Height="22" Margin="0,0,8,0">
                                            <Grid Width="24" Height="24">
                                                <Ellipse Width="21" Height="21"
                                                 Stroke="{DynamicResource ColorBordeMesSeleccionado}"
                                                 StrokeThickness="1.8"/>
                                                <Ellipse Width="13" Height="13"
                                                 Stroke="{DynamicResource ColorBordeMesSeleccionado}"
                                                 StrokeThickness="1.8"/>
                                                <Path Data="M 12,12 L 22,2 M 17,2 L 22,2 L 22,7"
                                              Stroke="{DynamicResource ColorBordeMesSeleccionado}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                            </Grid>
                                        </Viewbox>
                                        <TextBlock Text="Progreso"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ColorTexto}"
                                           VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock x:Name="TxtProgresoVacio"
                                       Text="Selecciona una tarea para ver su progreso y sus subtareas."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ColorTextoSecundario}"
                                       Visibility="Collapsed"
                                       Margin="0,4,0,6"/>

                                    <StackPanel x:Name="PanelProgresoSeleccionado"
                                        Visibility="Collapsed">

                                        <!-- INFORMACIÓN DE LA TAREA -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36"
                                                CornerRadius="18"
                                                Background="{DynamicResource ColorMesSeleccionado}"
                                                VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtProgresoIcono"
                                                       Text="✓"
                                                       FontSize="18"
                                                       Foreground="{DynamicResource ColorTexto}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                                                    <TextBlock x:Name="TxtProgresoTitulo"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource ColorTexto}"
                                                       TextWrapping="Wrap"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    <Border x:Name="PanelProgresoCategoria"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource ColorMesSeleccionado}"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Margin="0,2,0,0"
                                                    Visibility="Collapsed">
                                                        <TextBlock x:Name="TxtProgresoCategoria"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ColorTexto}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <Border Grid.Column="1"
                                            BorderBrush="{DynamicResource ColorBorde}"
                                            BorderThickness="1,0,0,0"
                                            Padding="10,0,0,0"
                                            VerticalAlignment="Center">
                                                <StackPanel MaxWidth="150">
                                                    <TextBlock x:Name="TxtProgresoFecha"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ColorTextoSecundario}"/>
                                                    <Border x:Name="PanelProgresoPrioridad"
                                                    CornerRadius="10"
                                                    Padding="7,2"
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Left"
                                                    Visibility="Collapsed">
                                                        <TextBlock x:Name="TxtProgresoPrioridad"
                                                           FontSize="10"
                                                           FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- CÍRCULO Y LISTA DE SUBTAREAS -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.85*"/>
                                                <ColumnDefinition Width="1.15*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Sin tarjeta de fondo: el círculo queda integrado -->
                                            <Viewbox Grid.Column="0"
                                             MaxWidth="122"
                                             MaxHeight="122"
                                             Stretch="Uniform"
                                             StretchDirection="DownOnly"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0">
                                                <Grid Width="142" Height="142">
                                                    <Ellipse x:Name="EllipseProgresoFondo"
                                                     Margin="6"
                                                     Stroke="{DynamicResource ColorBorde}"
                                                     StrokeThickness="12"/>
                                                    <Path x:Name="PathProgreso"
                                                  Stretch="None"
                                                  Stroke="#3FA772"
                                                  StrokeThickness="12"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Visibility="Collapsed"/>
                                                    <StackPanel Width="100" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                        <TextBlock x:Name="TxtPorcentajeProgreso"
                                                           Text="0%"
                                                           FontSize="32"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource ColorTexto}"
                                                           HorizontalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtTareasCompletadas"
                                                           Text="0 de 0 subtareas"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource ColorTextoSecundario}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Viewbox>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtSubtareasVacias"
                                                   Text="Esta tarea no tiene subtareas."
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ColorTextoSecundario}"
                                                   Visibility="Collapsed"/>
                                                <ScrollViewer MaxHeight="148"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel x:Name="PanelSubtareasProgreso"/>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Grid>

                                        <!-- PRÓXIMO PASO: indicación, no botón -->
                                        <Border Background="{DynamicResource ColorMesSeleccionado}"
                                        BorderBrush="{DynamicResource ColorBorde}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="9,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Viewbox Width="17" Height="17" Margin="0,0,7,0">
                                                        <Path Data="M 3,12 L 20,12 M 13,5 L 20,12 L 13,19"
                                                      Stroke="{DynamicResource ColorTexto}"
                                                      StrokeThickness="2.3"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                                    </Viewbox>
                                                    <TextBlock Text="Próximo paso"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource ColorTexto}"
                                                       VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                BorderBrush="{DynamicResource ColorBorde}"
                                                BorderThickness="1,0,0,0"
                                                Margin="10,0,0,0"
                                                Padding="10,0,0,0">
                                                    <TextBlock x:Name="TxtProximoPaso"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource ColorTexto}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>


                <!-- ================================================== -->
                <!-- CONTENEDOR DE SECCIONES -->
                <!--
                 Aquí se muestran Calendario y Ajustes.
                 Inicio continúa siendo VistaInicio.
            -->
                <!-- ================================================== -->

                <ContentControl x:Name="ContenedorSeccion"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>


                <!-- ================================================== -->
                <!-- BARRA DE NAVEGACIÓN INFERIOR -->
                <!-- ================================================== -->

                <Border Grid.Row="2"
                    Background="{DynamicResource ColorHeader}"
                    CornerRadius="0,0,20,20"
                    Padding="15,10">

                    <UniformGrid Rows="1"
                             Columns="3"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center">


                        <!-- INICIO -->

                        <Border x:Name="NavInicio"
                            Width="150"
                            Height="38"
                            Background="{DynamicResource ColorTarjetaInterna}"
                            CornerRadius="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseLeftButtonUp="Inicio_Click">

                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <TextBlock Text="🏠"
                                       FontSize="14"
                                       Margin="0,0,7,0"/>

                                <TextBlock x:Name="TxtNavInicio"
                                       Text="Inicio"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource ColorTexto}"/>

                            </StackPanel>

                        </Border>


                        <!-- CALENDARIO -->

                        <Border x:Name="NavCalendario"
                            Width="150"
                            Height="38"
                            Background="Transparent"
                            CornerRadius="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseLeftButtonUp="Calendario_Click">

                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <TextBlock Text="📅"
                                       FontSize="14"
                                       Margin="0,0,7,0"/>

                                <TextBlock x:Name="TxtNavCalendario"
                                       Text="Calendario"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorTextoHeader}"/>

                            </StackPanel>

                        </Border>


                        <!-- AJUSTES -->

                        <Border x:Name="NavAjustes"
                            Width="150"
                            Height="38"
                            Background="Transparent"
                            CornerRadius="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseLeftButtonUp="Ajustes_Click">

                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <TextBlock Text="⚙"
                                       FontSize="14"
                                       Margin="0,0,7,0"/>

                                <TextBlock x:Name="TxtNavAjustes"
                                       Text="Ajustes"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorTextoHeader}"/>

                            </StackPanel>

                        </Border>

                    </UniformGrid>

                </Border>
            </Grid>
        </Grid>

    </Border>

</Window>