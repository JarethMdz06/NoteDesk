<Window x:Class="NoteDesk.StickyTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tarea"
        Width="330"
        Height="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Window.Resources>

        <!-- ====================================================== -->
        <!-- SOMBRA -->
        <!-- ====================================================== -->

        <DropShadowEffect x:Key="StickyShadow"
                          BlurRadius="16"
                          ShadowDepth="4"
                          Opacity="0.28"/>

        <!-- ====================================================== -->
        <!-- BOTONES SUPERIORES -->
        <!-- ====================================================== -->

        <Style x:Key="HeaderButton"
               TargetType="Button">

            <Setter Property="Width"
                    Value="30"/>

            <Setter Property="Height"
                    Value="30"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Foreground"
                    Value="#444444"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Fondo"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Fondo"
                                        Property="Background"
                                        Value="#25FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ====================================================== -->
        <!-- CÍRCULOS DE COLOR -->
        <!-- ====================================================== -->

        <Style x:Key="ColorRadio"
               TargetType="RadioButton">

            <Setter Property="Width"
                    Value="38"/>

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Margin"
                    Value="3"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Grid>

                            <Ellipse x:Name="Seleccion"
                                     Fill="Transparent"
                                     Stroke="Transparent"
                                     StrokeThickness="2"/>

                            <Ellipse Margin="5"
                                     Fill="{TemplateBinding Background}"/>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="Seleccion"
                                        Property="Stroke"
                                        Value="#D4A719"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <!-- ====================================================== -->
    <!-- NOTA FLOTANTE -->
    <!-- ====================================================== -->

    <Border x:Name="StickyContainer"
            Margin="10"
            Background="#FFF3B8"
            CornerRadius="20"
            BorderBrush="#D2B450"
            BorderThickness="1"
            Effect="{StaticResource StickyShadow}"
            MouseLeftButtonDown="StickyContainer_MouseLeftButtonDown">

        <Grid>

            <!-- IMPORTANTE:
                 Todas las filas son Auto para evitar el espacio vacío -->

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- ====================================================== -->
            <!-- HEADER -->
            <!-- ====================================================== -->

            <Grid Grid.Row="0"
                  Margin="18,14,14,9">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <!-- ICONO -->

                <Border Width="42"
                        Height="42"
                        Background="#45FFFFFF"
                        CornerRadius="21">

                    <TextBlock x:Name="TxtCategoriaIcono"
                               Text="🎓"
                               FontSize="21"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>

                <!-- TÍTULO -->

                <StackPanel Grid.Column="1"
                            Margin="11,0,7,0"
                            VerticalAlignment="Center">

                    <TextBlock x:Name="TxtTitulo"
                               Text="Entregar proyecto"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#202020"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="TxtCategoria"
                               Text="School"
                               FontSize="10"
                               Foreground="#625C4B"
                               Margin="0,2,0,0"/>

                </StackPanel>

                <!-- REDUCIR -->

                <Button x:Name="BtnReducir"
                        Grid.Column="2"
                        Style="{StaticResource HeaderButton}"
                        Content="−"
                        ToolTip="Reducir"
                        Click="BtnReducir_Click"/>

                <!-- CERRAR -->

                <Button x:Name="BtnCerrar"
                        Grid.Column="3"
                        Style="{StaticResource HeaderButton}"
                        Content="×"
                        FontSize="18"
                        ToolTip="Cerrar"
                        Click="BtnCerrar_Click"/>

            </Grid>

            <!-- ====================================================== -->
            <!-- DIVISOR SUPERIOR -->
            <!-- ====================================================== -->

            <Border Grid.Row="1"
                    Height="1"
                    Background="#3F9D8749"
                    Margin="18,0"/>

            <!-- ====================================================== -->
            <!-- CONTENIDO -->
            <!-- ====================================================== -->

            <StackPanel x:Name="PanelContenido"
                        Grid.Row="2"
                        Margin="20,14,20,9">

                <!-- DESCRIPCIÓN -->

                <TextBlock x:Name="TxtDescripcion"
                           Text="Terminar la presentación y revisar los últimos cambios antes de realizar la entrega."
                           FontSize="12"
                           Foreground="#3D382D"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           Margin="0,0,0,14"/>

                <!-- ====================================================== -->
                <!-- FECHA -->
                <!-- ====================================================== -->

                <Border x:Name="PanelFecha"
                        Background="#38FFFFFF"
                        CornerRadius="12"
                        Padding="11,9"
                        Margin="0,0,0,10">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="▣"
                                   FontSize="15"
                                   Foreground="#555046"
                                   Margin="0,0,9,0"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="TxtFecha"
                                   Grid.Column="1"
                                   Text="28 de Octubre, 2026"
                                   FontSize="10"
                                   Foreground="#49453A"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="›"
                                   FontSize="19"
                                   Foreground="#615C51"
                                   VerticalAlignment="Center"/>

                    </Grid>

                </Border>

                <!-- ====================================================== -->
                <!-- GOOGLE DRIVE -->
                <!-- ====================================================== -->

                <Border x:Name="PanelDrive"
                        Background="#38FFFFFF"
                        CornerRadius="12"
                        Padding="11,9">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="🔗"
                                   FontSize="15"
                                   Margin="0,0,9,0"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="TxtDrive"
                                   Grid.Column="1"
                                   Text="Archivo en Google Drive"
                                   FontSize="10"
                                   Foreground="#49453A"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="›"
                                   FontSize="19"
                                   Foreground="#615C51"
                                   VerticalAlignment="Center"/>

                    </Grid>

                </Border>

            </StackPanel>

            <!-- ====================================================== -->
            <!-- COLOR DE LA NOTA -->
            <!-- ====================================================== -->

            <StackPanel Grid.Row="3"
                        Margin="18,2,18,12">

                <!-- LÍNEA -->

                <Border Height="1"
                        Background="#3F9D8749"
                        Margin="0,0,0,8"/>

                <!-- ====================================================== -->
                <!-- CABECERA COLOR -->
                <!-- ====================================================== -->

                <Grid Height="32">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="◉"
                                   FontSize="14"
                                   Foreground="#655F53"
                                   Margin="0,0,6,0"/>

                        <TextBlock Text="Color de la nota"
                                   FontSize="11"
                                   Foreground="#655F53"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <!-- BOTÓN DESPLEGAR -->

                    <Button x:Name="BtnMostrarColores"
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Mostrar colores"
                            Click="BtnMostrarColores_Click">

                        <TextBlock x:Name="TxtFlechaColor"
                                   Text="⌄"
                                   FontSize="18"
                                   Foreground="#555555"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Button>

                </Grid>

                <!-- ====================================================== -->
                <!-- COLORES -->
                <!-- OCULTOS AL INICIAR -->
                <!-- ====================================================== -->

                <Border x:Name="PanelColores"
                        Margin="0,7,0,0"
                        Visibility="Collapsed">

                    <WrapPanel HorizontalAlignment="Left">

                        <!-- AMARILLO -->

                        <RadioButton x:Name="ColorAmarillo"
                                     GroupName="StickyColors"
                                     Style="{StaticResource ColorRadio}"
                                     Background="#FFF3B8"
                                     IsChecked="True"
                                     Checked="Color_Checked"/>

                        <!-- DURAZNO -->

                        <RadioButton x:Name="ColorDurazno"
                                     GroupName="StickyColors"
                                     Style="{StaticResource ColorRadio}"
                                     Background="#FFD0B6"
                                     Checked="Color_Checked"/>

                        <!-- ROSA -->

                        <RadioButton x:Name="ColorRosa"
                                     GroupName="StickyColors"
                                     Style="{StaticResource ColorRadio}"
                                     Background="#F5B5D5"
                                     Checked="Color_Checked"/>

                        <!-- LAVANDA -->

                        <RadioButton x:Name="ColorLavanda"
                                     GroupName="StickyColors"
                                     Style="{StaticResource ColorRadio}"
                                     Background="#D6C3F5"
                                     Checked="Color_Checked"/>

                        <!-- AZUL -->

                        <RadioButton x:Name="ColorAzul"
                                     GroupName="StickyColors"
                                     Style="{StaticResource ColorRadio}"
                                     Background="#B6DDF7"
                                     Checked="Color_Checked"/>

                        <!-- VERDE -->

                        <RadioButton x:Name="ColorVerde"
                                     GroupName="StickyColors"
                                     Style="{StaticResource ColorRadio}"
                                     Background="#C5EDC5"
                                     Checked="Color_Checked"/>

                        <!-- GRIS -->

                        <RadioButton x:Name="ColorGris"
                                     GroupName="StickyColors"
                                     Style="{StaticResource ColorRadio}"
                                     Background="#E2E2E2"
                                     Checked="Color_Checked"/>

                    </WrapPanel>

                </Border>

            </StackPanel>

        </Grid>

    </Border>

</Window>