                    </Border>

                </Grid>


                <!-- ===================================================== -->
                <!-- PANEL DERECHO -->
                <!-- ===================================================== -->

                <StackPanel Grid.Column="4">

                    <!-- VISTA DEL AÑO -->

                    <Border Background="#F8F4EA"
                            CornerRadius="16"
                            Padding="16"
                            Margin="0,0,0,16"
                            Effect="{StaticResource CardShadow}">

                        <StackPanel>

                            <Grid Margin="0,0,0,12">

                                <TextBlock Text="Vista del Año"
                                           FontSize="17"
                                           FontWeight="Bold"/>

                                <ComboBox HorizontalAlignment="Right"
                                          Width="90"
                                          Height="32"
                                          SelectedIndex="0">

                                    <ComboBoxItem Content="2025"/>

                                    <ComboBoxItem Content="2026"/>

                                    <ComboBoxItem Content="2027"/>

                                </ComboBox>

                            </Grid>

                            <UniformGrid Columns="4">

                                <Button Content="Ene"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Feb"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Mar"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Abr"
                                        Style="{StaticResource MonthButton}"
                                        Background="#FFF2C3"
                                        BorderBrush="#E8B32D"
                                        BorderThickness="2"/>

                                <Button Content="May"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Jun"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Jul"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Ago"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Sep"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Oct"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Nov"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Dic"
                                        Style="{StaticResource MonthButton}"/>

                            </UniformGrid>

                        </StackPanel>

                    </Border>


                    <!-- TAREAS DE ABRIL -->

                    <Border Background="#F8F4EA"
                            CornerRadius="16"
                            Padding="16"
                            Effect="{StaticResource CardShadow}">

                        <StackPanel>

                            <TextBlock Text="Tareas de Abril"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"/>


                            <!-- TAREA -->

                            <Border Style="{StaticResource TaskItemStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <Border Width="34"
                                            Height="34"
                                            Background="#E9D5FF"
                                            CornerRadius="8">

                                        <TextBlock Text="🎓"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="10,0">

                                        <TextBlock Text="Entrega de tarea"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="1 de Abril"
                                                   FontSize="11"
                                                   Foreground="#777777"/>

                                    </StackPanel>

                                </Grid>

                            </Border>


                            <Border Style="{StaticResource TaskItemStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <Border Width="34"
                                            Height="34"
                                            Background="#FFDDE3"
                                            CornerRadius="8">

                                        <TextBlock Text="♥"
                                                   Foreground="#C64250"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="10,0">

                                        <TextBlock Text="Médico"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="3 de Abril"
                                                   FontSize="11"
                                                   Foreground="#777777"/>

                                    </StackPanel>

                                </Grid>

                            </Border>


                            <Border Style="{StaticResource TaskItemStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <Border Width="34"
                                            Height="34"
                                            Background="#DFF3E5"
                                            CornerRadius="8">

                                        <TextBlock Text="🛒"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="10,0">

                                        <TextBlock Text="Comprar despensa"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="5 de Abril"
                                                   FontSize="11"
                                                   Foreground="#777777"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Grid>


            <!-- ===================================================== -->
            <!-- BARRA INFERIOR -->
            <!-- ===================================================== -->

            <Border Grid.Row="1"
                    Background="#E7CD63"
                    CornerRadius="0,0,20,20"
                    Padding="15,10">

                <UniformGrid Columns="3"
                             Rows="1">

                    <!-- INICIO -->

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <TextBlock Text="⌂"
                                   FontSize="17"
                                   Margin="0,0,6,0"/>

                        <TextBlock Text="Inicio"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <!-- CALENDARIO -->

                    <Border Background="#FFF2C3"
                            CornerRadius="16"
                            Padding="20,5"
                            HorizontalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="▣"
                                       FontSize="16"
                                       Margin="0,0,6,0"/>

                            <TextBlock Text="Calendario"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                    <!-- AJUSTES -->

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <TextBlock Text="⚙"
                                   FontSize="16"
                                   Margin="0,0,6,0"/>

                        <TextBlock Text="Ajustes"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                </UniformGrid>

            </Border>

        </Grid>

    </Border>

</Window>