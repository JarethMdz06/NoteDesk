                                                Background="#52B788" 
                                                Foreground="White" 
                                                FontWeight="SemiBold" 
                                                BorderThickness="0" 
                                                Height="28" 
                                                Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>

                                </Border>
                            </Popup>
                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ===================================================== -->
                <!-- PANEL CENTRAL -->
