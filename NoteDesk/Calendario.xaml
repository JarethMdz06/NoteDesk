                                CornerRadius="10"
                                Padding="10"
                                Margin="0,0,0,8">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="🎓"
                                           FontSize="17"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="School"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>

                                <Ellipse Grid.Column="2"
                                         Width="16"
                                         Height="16"
                                         Fill="#A56AE8"
                                         VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <!-- HOME -->

                        <Border Background="#E6F1FF"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,0,0,8">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="⌂"
                                           FontSize="19"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="Home"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>

                                <Ellipse Grid.Column="2"
                                         Width="16"
                                         Height="16"
                                         Fill="#6FBAF5"
                                         VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <!-- SHOPPING -->

                        <Border Background="#E1F6E8"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,0,0,8">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="🛒"
                                           FontSize="17"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
