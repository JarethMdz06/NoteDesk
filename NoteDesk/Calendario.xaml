                            </Grid>


                            <!-- DÍAS -->

                            <UniformGrid Grid.Row="1"
                                         Columns="7"
                                         Background="#F5F0E6">

                                <TextBlock Text="Dom"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Lun"
