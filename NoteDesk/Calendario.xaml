                                                   VerticalAlignment="Center"/> 

                                        <Ellipse Grid.Column="2"
                                                 Width="16"
                                                 Height="16"
                                                 Fill="#BBBBBB"
                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </ToggleButton>

                            <!-- 2. El Popup que se abre y cierra automáticamente sin código C# -->
