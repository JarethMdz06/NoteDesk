                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <Button Width="40"
                                        Height="40"
                                        Content="‹"
                                        FontSize="24"
                                        Background="#FFFDF7"
                                        BorderBrush="#DDD3C2"
                                        Cursor="Hand"/>

                                <TextBlock Grid.Column="1"
                                           Text="Abril 2025"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#222222"/>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal">

                                    <Button Content="Hoy"
                                            Width="70"
                                            Height="40"
                                            Background="#FFFDF7"
                                            BorderBrush="#DDD3C2"
