<UserControl x:Class="NoteDesk.Calendario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent">

    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
        </Style>

        <!-- SOMBRAS -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12"
                          ShadowDepth="3"
                          Opacity="0.18"/>

        <!-- BOTÓN MENÚ LATERAL -->

        <Style x:Key="MenuButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource ColorTexto}"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">

                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- BOTÓN MES -->

        <Style x:Key="MonthButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Margin"
                    Value="4"/>

            <Setter Property="Background"
                    Value="{DynamicResource ColorSuperficie}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource ColorBorde}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource ColorTexto}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="MonthButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MonthButtonBorder" Property="Background" Value="{DynamicResource ColorMesSeleccionado}"/>
                                <Setter TargetName="MonthButtonBorder" Property="BorderBrush" Value="{DynamicResource ColorBordeMesSeleccionado}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MonthButtonBorder" Property="Background" Value="{DynamicResource ColorHeader}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="CalendarNavigationButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ColorSuperficie}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorde}"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTexto}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ColorMesSeleccionado}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ColorBordeMesSeleccionado}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ColorHeader}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarTodayButton" TargetType="Button" BasedOn="{StaticResource CalendarNavigationButton}">
            <Setter Property="Background" Value="{DynamicResource ColorHeader}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorBordeMesSeleccionado}"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorTextoHeader}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- TARJETA DE TAREA -->

        <Style x:Key="TaskItemStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{DynamicResource ColorSuperficie}"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="10"/>

            <Setter Property="Margin"
                    Value="0,0,0,8"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

        <!-- CELDA DEL CALENDARIO -->

        <Style x:Key="CalendarCell"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{DynamicResource ColorSuperficie}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource ColorBorde}"/>

            <Setter Property="BorderThickness"
                    Value="0.5"/>

            <Setter Property="MinHeight"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="5"/>

        </Style>

    </UserControl.Resources>

    <!-- FONDO GENERAL -->

    <Border Margin="14"
