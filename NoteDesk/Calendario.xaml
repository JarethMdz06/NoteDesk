                                   Placement="Bottom" 
                                   HorizontalOffset="0" 
                                   VerticalOffset="5"
                                   AllowsTransparency="True">
                                


                                <Border Background="#F4EEE0" 
                                        BorderBrush="#DCD3C1" 
                                        BorderThickness="1" 
                                        CornerRadius="12" 
                                        Padding="15" 
                                        Width="180">

                                    <StackPanel>
                                        <TextBlock Text="Nueva Categoría" 
                                                   FontWeight="Bold" 
                                                   FontSize="13" 
                                                   Foreground="#333333" 
                                                   Margin="0,0,0,8"/>   

                                        <!-- Campo para escribir el nombre -->
