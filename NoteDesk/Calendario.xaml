                                    <TextBlock Text="29"/>
                                </Border>

                                <!-- 30 -->

                                <Border Style="{StaticResource CalendarCell}">
                                    <TextBlock Text="30"/>
                                </Border>

                                <!-- 1 -->

                                <Border Style="{StaticResource CalendarCell}">
                                    <TextBlock Text="1"
                                               Foreground="{DynamicResource ColorDiasOtroMes}"/>
                                </Border>

                                <!-- 2 -->

                                <Border Style="{StaticResource CalendarCell}">
                                    <TextBlock Text="2"
                                               Foreground="{DynamicResource ColorDiasOtroMes}"/>
                                </Border>

                                <!-- 3 -->

                                <Border Style="{StaticResource CalendarCell}">
                                    <TextBlock Text="3"
                                               Foreground="{DynamicResource ColorDiasOtroMes}"/>
                                </Border>

                            </UniformGrid>

                        </Grid>

                    </Border>

                </Grid>



                <!-- PANEL DERECHO -->


                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- VISTA DEL AÑO -->

                    <Border Grid.Row="0"
                            Background="{DynamicResource ColorTarjetaInterna}"
                            CornerRadius="16"
                            Padding="16"
                            Margin="0,0,0,16"
                            Effect="{StaticResource CardShadow}">

                        <StackPanel>

                            <Grid Margin="0,0,0,12">

                                <TextBlock Text="Vista del Año"
                                           FontSize="17"
                                           FontWeight="Bold"/>

                                <ComboBox x:Name="CmbAnio"
                                          HorizontalAlignment="Right"
                                          Width="100"
                                          Height="36"
                                          Style="{StaticResource NoteDeskComboBox}"
                                          SelectionChanged="Anio_SelectionChanged"/>

                            </Grid>

                            <UniformGrid x:Name="MesesDelAnio" Columns="4">

                                <Button Content="Ene"
                                        Tag="1"
                                        Click="Mes_Click"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Feb"
                                        Tag="2"
                                        Click="Mes_Click"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Mar"
                                        Tag="3"
                                        Click="Mes_Click"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Abr"
                                        Tag="4"
                                        Click="Mes_Click"
                                        Style="{StaticResource MonthButton}"
                                        Background="{DynamicResource ColorMesSeleccionado}"
                                        BorderBrush="{DynamicResource ColorBordeMesSeleccionado}"
                                        BorderThickness="2"/>

                                <Button Content="May"
                                        Tag="5"
                                        Click="Mes_Click"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Jun"
                                        Tag="6"
                                        Click="Mes_Click"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Jul"
                                        Tag="7"
                                        Click="Mes_Click"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Ago"
                                        Tag="8"
                                        Click="Mes_Click"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Sep"
                                        Tag="9"
                                        Click="Mes_Click"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Oct"
                                        Tag="10"
                                        Click="Mes_Click"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Nov"
                                        Tag="11"
                                        Click="Mes_Click"
                                        Style="{StaticResource MonthButton}"/>

                                <Button Content="Dic"
                                        Tag="12"
                                        Click="Mes_Click"
                                        Style="{StaticResource MonthButton}"/>

                            </UniformGrid>

                        </StackPanel>

                    </Border>


                    <!-- TAREAS DEL MES -->

                    <Border Grid.Row="1"
                            Background="{DynamicResource ColorTarjetaInterna}"
                            CornerRadius="16"
                            Padding="16"
                            Effect="{StaticResource CardShadow}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="TxtEncabezadoTareasMes"
                                       Text="Tareas del mes"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12"/>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PanelTareasMes"/>
                            </ScrollViewer>
                        </Grid>

                    </Border>

                </Grid>

            </Grid>



        </Grid>

    </Border>

</UserControl>