                                CornerRadius="10"
                                Padding="10"
                                Margin="0,0,0,8">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="♥"
                                           FontSize="17"
                                           Foreground="#C7424F"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="Health"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>

                                <Ellipse Grid.Column="2"
                                         Width="16"
                                         Height="16"
                                         Fill="#EE6680"
                                         VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                        <!-- OTHER -->

                        <Grid>
                            <!-- 1. El ToggleButton que mantiene tu diseño exacto pero funciona como interruptor -->
                            <ToggleButton x:Name="BtnMenuCategoria" 
                                          Background="Transparent" 
                                          BorderBrush="Transparent" 
                                          Cursor="Hand" 
                                          Padding="0">

                                <!-- Esto quita el efecto gris feo por defecto del ToggleButton de Windows -->
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <!-- Tu diseño original intacto -->
                                <Border Background="#ECECEC"
                                        CornerRadius="10"
                                        Padding="10">
