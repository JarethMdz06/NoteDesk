                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="65"/>

                                <RowDefinition Height="42"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>


                            <!-- CABECERA MES -->

                            <Grid Grid.Row="0"
