                            </Grid>

                        </Border>

                    </Grid>

                    <!-- CALENDARIO -->

                    <Border Grid.Row="2"
                            Background="{DynamicResource ColorTarjetaInterna}"
                            CornerRadius="16"
                            Effect="{StaticResource CardShadow}">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="72"/>

                                <RowDefinition Height="42"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>


                            <!-- CABECERA MES -->

                            <Grid Grid.Row="0"
                                  Margin="14">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <Button Width="40"
                                        Height="40"
                                        Content="‹"
                                        FontSize="24"
                                        Style="{StaticResource CalendarNavigationButton}"
                                        Click="MesAnterior_Click"/>

                                <TextBlock x:Name="TxtMesCalendario"
