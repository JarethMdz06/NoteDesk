                                           Text="Abril 2025"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource ColorTexto}"/>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal">

                                    <Button Content="Hoy"
                                            Width="70"
                                            Height="40"
                                            Style="{StaticResource CalendarTodayButton}"
                                            Margin="0,0,8,0"
