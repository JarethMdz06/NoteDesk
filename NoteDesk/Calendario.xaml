<Window x:Class="NoteDesk.Calendario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoteDesk - Calendario"
        Height="820"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#EBE2CD">

    <Window.Resources>

        <!-- SOMBRAS -->

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12"
                          ShadowDepth="3"
                          Opacity="0.18"/>

        <!-- BOTÓN MENÚ LATERAL -->

        <Style x:Key="MenuButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#333333"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">

                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- BOTÓN MES -->

        <Style x:Key="MonthButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Margin"
                    Value="4"/>

            <Setter Property="Background"
                    Value="#FFFDF7"/>

            <Setter Property="BorderBrush"
                    Value="#DED4BD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- TARJETA DE TAREA -->

        <Style x:Key="TaskItemStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#FFFDF7"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="10"/>

            <Setter Property="Margin"
                    Value="0,0,0,8"/>

            <Setter Property="BorderBrush"
                    Value="#E1D8C7"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

        <!-- CELDA DEL CALENDARIO -->

        <Style x:Key="CalendarCell"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#FFFDF7"/>

            <Setter Property="BorderBrush"
                    Value="#E5DDCF"/>

            <Setter Property="BorderThickness"
                    Value="0.5"/>

            <Setter Property="MinHeight"
                    Value="88"/>

            <Setter Property="Padding"
                    Value="8"/>

        </Style>

    </Window.Resources>

    <!-- FONDO GENERAL -->

    <Border Margin="14"
            Background="#ECE3D0"
            CornerRadius="20"
            Effect="{StaticResource CardShadow}">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- CONTENIDO -->

            <Grid Grid.Row="0"
                  Margin="16">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="210"/>

                    <ColumnDefinition Width="18"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="18"/>

                    <ColumnDefinition Width="300"/>

                </Grid.ColumnDefinitions>


                <!-- ===================================================== -->
                <!-- PANEL IZQUIERDO -->
                <!-- ===================================================== -->

                <Border Grid.Column="0"
                        Background="#F8F4EA"
                        CornerRadius="16"
                        Padding="16"
                        Effect="{StaticResource CardShadow}">

                    <StackPanel>

                        <!-- CATEGORÍAS -->



                        <TextBlock Text="Categorías"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#222222"
                                   Margin="0,0,0,12"/>

                        <!-- WORK -->

                        <Border Background="#FFF3CE"
                                CornerRadius="10"
                                Padding="10"
                                Margin="0,0,0,8">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Text="💼"
                                           FontSize="17"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="Work"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>

                                <Ellipse Grid.Column="2"
